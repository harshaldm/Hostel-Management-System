<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Complaints - Hostel Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { background-color: #f5f7fa; font-family: 'Segoe UI', sans-serif; }
        .sidebar { min-height: 100vh; background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%); }
        .sidebar a { color: #b8b8b8; text-decoration: none; padding: 12px 20px; display: block; border-radius: 8px; margin: 4px 10px; }
        .sidebar a:hover, .sidebar a.active { background: #0f3460; color: #fff; }
        .card { border: none; border-radius: 12px; box-shadow: 0 2px 15px rgba(0,0,0,0.05); }
        .navbar { background: linear-gradient(90deg, #1a1a2e 0%, #16213e 100%); }
    </style>
</head>
<body>
<div class="container-fluid">
    <div class="row">
        <div class="col-md-2 sidebar p-0">
            <div class="text-center py-4"><h5 class="text-white"><i class="bi bi-building"></i> Hostel</h5></div>
            <a href="/room/students" class="<%= page === 'students' ? 'active' : '' %>"><i class="bi bi-people"></i> Students</a>
            <a href="/room/rooms" class="<%= page === 'rooms' ? 'active' : '' %>"><i class="bi bi-door-open"></i> Rooms</a>
            <a href="/room/allocations" class="<%= page === 'allocations' ? 'active' : '' %>"><i class="bi bi-person-plus"></i> Allocation</a>
            <a href="/room/leave" class="<%= page === 'leave' ? 'active' : '' %>"><i class="bi bi-calendar-minus"></i> Leave</a>
            <a href="/room/complaints" class="<%= page === 'complaints' ? 'active' : '' %>"><i class="bi bi-exclamation-triangle"></i> Complaints</a>
            <a href="/room/visitors" class="<%= page === 'visitors' ? 'active' : '' %>"><i class="bi bi-people"></i> Visitors</a>
            <hr class="text-secondary">
            <div class="text-center text-secondary small py-2">MESS</div>
            <a href="/mess/fees" class="<%= page === 'fees' ? 'active' : '' %>"><i class="bi bi-cash"></i> Fees</a>
            <a href="/mess/leaves" class="<%= page === 'leaves' ? 'active' : '' %>"><i class="bi bi-calendar-minus"></i> Leaves & Refunds</a>
            <a href="/mess/menu" class="<%= page === 'menu' ? 'active' : '' %>"><i class="bi bi-list-ol"></i> Weekly Menu</a>
            <a href="/mess/staff" class="<%= page === 'staff' ? 'active' : '' %>"><i class="bi bi-person-badge"></i> Staff</a>
            <a href="/mess/vendors" class="<%= page === 'vendors' ? 'active' : '' %>"><i class="bi bi-truck"></i> Vendors</a>
            <a href="/mess/expenses" class="<%= page === 'expenses' ? 'active' : '' %>"><i class="bi bi-receipt"></i> Expenses</a>
            <hr class="text-secondary">
            <div class="text-center text-secondary small py-2">SPORTS</div>
            <a href="/sports/dashboard" class="<%= page === 'sports-dashboard' ? 'active' : '' %>"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a href="/sports/inventory" class="<%= page === 'sports-inventory' ? 'active' : '' %>"><i class="bi bi-box-seam"></i> Inventory</a>
            <a href="/sports/issues" class="<%= page === 'sports-issues' ? 'active' : '' %>"><i class="bi bi-journal-arrow-up"></i> Issues</a>
            <a href="/sports/fines" class="<%= page === 'sports-fines' ? 'active' : '' %>"><i class="bi bi-cash-coin"></i> Fines</a>
        </div>
        <div class="col-md-10">
            <nav class="navbar navbar-expand-lg navbar-dark px-4">
                <span class="navbar-brand">Hostel Management System</span>
                <div class="ms-auto"><a href="/logout" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right"></i> Logout</a></div>
            </nav>
            <div class="p-4">
                <div class="page-header d-flex justify-content-between align-items-center">
                    <h4><i class="bi bi-exclamation-triangle"></i> Complaints</h4>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addModal"><i class="bi bi-plus"></i> Add Complaint</button>
                </div>
                <div class="card">
                    <div class="card-body">
                        <table class="table table-hover">
                            <thead class="table-light"><tr><th>Student</th><th>Room</th><th>Issue Type</th><th>Description</th><th>Status</th><th>Actions</th></tr></thead>
                            <tbody>
                                <% if (complaints.length > 0) { %>
                                <% complaints.forEach(function(c) { %>
                                <tr>
                                    <td><%= c.name %></td><td><%= c.room_number %></td><td><%= c.issue_type %></td><td><%= c.description %></td>
                                    <td>
                                        <span class="badge status-badge <%= c.status === 'Resolved' ? 'bg-success' : c.status === 'In Progress' ? 'bg-warning text-dark' : c.status === 'Cancelled' ? 'bg-secondary' : 'bg-danger' %>">
                                            <%= c.status %>
                                        </span>
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm" style="width: 140px; font-weight: 500;"
                                                data-complaint-id="<%= c.complaint_id %>"
                                                onchange="updateComplaintStatus(this, '<%= c.complaint_id %>')">
                                            <option value="Pending" <%= c.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                                            <option value="In Progress" <%= c.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
                                            <option value="Resolved" <%= c.status === 'Resolved' ? 'selected' : '' %>>Resolved</option>
                                            <option value="Cancelled" <%= c.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                                        </select>
                                    </td>
                                </tr>
                                <% }); %>
                                <% } else { %>
                                <tr><td colspan="6" class="text-center text-muted">No complaints</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Add Complaint</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <form method="POST" action="/room/complaints/add">
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label">Student</label><select name="bt_no" class="form-select" required><% students.forEach(function(s) { %><option value="<%= s.bt_no %>"><%= s.name %></option><% }); %></select></div>
                    <div class="mb-3"><label class="form-label">Room</label><select name="room_no" class="form-select" required><% rooms.forEach(function(r) { %><option value="<%= r.room_no %>">Room <%= r.room_no %></option><% }); %></select></div>
                    <div class="mb-3">
                        <label class="form-label">Issue Type</label>
                        <select name="issue_type" class="form-select" required>
                            <option value="">Select Issue Type</option>
                            <option value="Electrical">Electrical</option>
                            <option value="Plumbing">Plumbing</option>
                            <option value="Furniture">Furniture</option>
                            <option value="Cleaning">Cleaning</option>
                            <option value="Internet">Internet</option>
                            <option value="Pest Control">Pest Control</option>
                        </select>
                    </div>
                    <div class="mb-3"><label class="form-label">Description</label><textarea name="description" class="form-control" maxlength="500" required></textarea></div>
                </div>
                <div class="modal-footer"><button type="submit" class="btn btn-primary">Submit</button></div>
            </form>
        </div>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
    <div id="statusToast" class="toast align-items-center text-white border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="statusToastBody">Status updated</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
async function updateComplaintStatus(selectElem, complaintId) {
    const newStatus = selectElem.value;
    const row = selectElem.closest('tr');
    const badge = row.querySelector('.status-badge');
    const prevStatus = badge.textContent.trim();
    
    try {
        const response = await fetch(`/complaints/${complaintId}/status`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status: newStatus })
        });
        const data = await response.json();
        if (!response.ok || !data.success) {
            throw new Error(data.error || 'Failed to update complaint status');
        }
        
        badge.textContent = newStatus;
        let badgeClass = 'bg-danger';
        if (newStatus === 'Resolved') badgeClass = 'bg-success';
        else if (newStatus === 'In Progress') badgeClass = 'bg-warning text-dark';
        else if (newStatus === 'Cancelled') badgeClass = 'bg-secondary';
        
        badge.className = `badge status-badge ${badgeClass}`;
        showToast(`Complaint #${complaintId} status updated to ${newStatus}`, true);
    } catch (err) {
        selectElem.value = prevStatus;
        showToast(err.message, false);
    }
}

function showToast(message, isSuccess) {
    const toastEl = document.getElementById('statusToast');
    const bodyEl = document.getElementById('statusToastBody');
    bodyEl.textContent = message;
    toastEl.className = `toast align-items-center text-white border-0 ${isSuccess ? 'bg-success' : 'bg-danger'}`;
    const toast = new bootstrap.Toast(toastEl, { delay: 3000 });
    toast.show();
}
</script>
</body>
</html>