<% 
const pageTitle = 'Students';
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Students - Hostel Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { background-color: #f5f7fa; font-family: 'Segoe UI', sans-serif; }
        .sidebar { min-height: 100vh; background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%); }
        .sidebar a { color: #b8b8b8; text-decoration: none; padding: 12px 20px; display: block; border-radius: 8px; margin: 4px 10px; transition: all 0.3s; }
        .sidebar a:hover { background: rgba(255, 255, 255, 0.08); color: #fff; }
        .sidebar a.active { background: #0f3460; color: #fff; font-weight: 600; }
        .sidebar a i { margin-right: 10px; }
        .card { border: none; border-radius: 12px; box-shadow: 0 2px 15px rgba(0,0,0,0.05); }
        .navbar { background: linear-gradient(90deg, #1a1a2e 0%, #16213e 100%); }
    </style>
</head>
<body>
<div class="container-fluid">
    <div class="row">
        <div class="col-md-2 sidebar p-0">
            <div class="text-center py-4">
                <h5 class="text-white"><i class="bi bi-building"></i> Hostel</h5>
            </div>
            <a href="/room/students" class="<%= page === 'students' ? 'active' : '' %>"><i class="bi bi-people"></i> Students</a>
            <a href="/room/rooms" class="<%= page === 'rooms' ? 'active' : '' %>"><i class="bi bi-door-open"></i> Rooms</a>
            <a href="/room/allocations" class="<%= page === 'allocations' ? 'active' : '' %>"><i class="bi bi-person-plus"></i> Allocation</a>
            <a href="/room/leave" class="<%= page === 'leave' ? 'active' : '' %>"><i class="bi bi-calendar-minus"></i> Leave</a>
            <a href="/room/complaints" class="<%= page === 'complaints' ? 'active' : '' %>"><i class="bi bi-exclamation-triangle"></i> Complaints</a>
            <a href="/room/visitors" class="<%= page === 'visitors' ? 'active' : '' %>"><i class="bi bi-people"></i> Visitors</a>
            <hr class="text-secondary">
            <div class="text-center text-secondary small py-2">MESS</div>
            <a href="/mess/fees" class="<%= page === 'fees' ? 'active' : '' %>"><i class="bi bi-cash"></i> Fees</a>
            <a href="/mess/leaves" class="<%= page === 'leaves' ? 'active' : '' %>"><i class="bi bi-calendar-minus"></i> Leaves & Refunds</a>
            <a href="/mess/menu" class="<%= page === 'menu' ? 'active' : '' %>"><i class="bi bi-list-ol"></i> Weekly Menu</a>
            <a href="/mess/staff" class="<%= page === 'staff' ? 'active' : '' %>"><i class="bi bi-person-badge"></i> Staff</a>
            <a href="/mess/vendors" class="<%= page === 'vendors' ? 'active' : '' %>"><i class="bi bi-truck"></i> Vendors</a>
            <a href="/mess/expenses" class="<%= page === 'expenses' ? 'active' : '' %>"><i class="bi bi-receipt"></i> Expenses</a>
            <hr class="text-secondary">
            <div class="text-center text-secondary small py-2">SPORTS</div>
            <a href="/sports/dashboard" class="<%= page === 'sports-dashboard' ? 'active' : '' %>"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a href="/sports/inventory" class="<%= page === 'sports-inventory' ? 'active' : '' %>"><i class="bi bi-box-seam"></i> Inventory</a>
            <a href="/sports/issues" class="<%= page === 'sports-issues' ? 'active' : '' %>"><i class="bi bi-journal-arrow-up"></i> Issues</a>
            <a href="/sports/fines" class="<%= page === 'sports-fines' ? 'active' : '' %>"><i class="bi bi-cash-coin"></i> Fines</a>
        </div>
        <div class="col-md-10">
            <nav class="navbar navbar-expand-lg navbar-dark px-4">
                <span class="navbar-brand">Hostel Management System</span>
                <div class="ms-auto">
                    <a href="/logout" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right"></i> Logout</a>
                </div>
            </nav>
            <div class="p-4">
                <div class="page-header d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="mb-1"><i class="bi bi-people-fill text-primary"></i> Student Management</h4>
                        <p class="text-muted small mb-0">Manage registered hostel students with validated credentials</p>
                    </div>
                    <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#addModal">
                        <i class="bi bi-person-plus-fill me-1"></i> Add Student
                    </button>
                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-3 shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
                    <div><%= error %></div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <% } %>

                <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-3 shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill flex-shrink-0 me-2 fs-5"></i>
                    <div><%= success %></div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <% } %>

                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                            <div class="input-group" style="max-width: 320px;">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                                <input type="text" id="studentSearchInput" class="form-control border-start-0 ps-0" placeholder="Search by BT No, Name, Branch...">
                            </div>
                            <span class="badge bg-light text-dark border px-3 py-2">
                                <i class="bi bi-people me-1"></i> Total: <strong id="studentCount"><%= students.length %></strong> Students
                            </span>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>BT No</th>
                                        <th>Name</th>
                                        <th>Year</th>
                                        <th>Phone</th>
                                        <th>Email</th>
                                        <th>Branch</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="studentTableBody">
                                    <% if (students.length > 0) { %>
                                        <% students.forEach(function(student) { %>
                                        <tr>
                                            <td>
                                                <span class="font-monospace fw-bold text-primary"><%= student.bt_no %></span>
                                            </td>
                                            <td class="fw-semibold text-dark"><%= student.name %></td>
                                            <td>
                                                <% if (student.year == 1) { %>
                                                    <span class="badge bg-primary text-white px-2 py-1"><i class="bi bi-mortarboard me-1"></i>1st Year</span>
                                                <% } else if (student.year == 2) { %>
                                                    <span class="badge bg-info text-dark px-2 py-1"><i class="bi bi-mortarboard me-1"></i>2nd Year</span>
                                                <% } else if (student.year == 3) { %>
                                                    <span class="badge bg-warning text-dark px-2 py-1"><i class="bi bi-mortarboard me-1"></i>3rd Year</span>
                                                <% } else if (student.year == 4) { %>
                                                    <span class="badge bg-success text-white px-2 py-1"><i class="bi bi-mortarboard me-1"></i>4th Year</span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary px-2 py-1"><%= student.year %></span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <span class="font-monospace small">
                                                    <i class="bi bi-phone text-muted me-1"></i><%= student.phone %>
                                                </span>
                                            </td>
                                            <td>
                                                <a href="mailto:<%= student.email %>" class="text-decoration-none text-muted small">
                                                    <i class="bi bi-envelope me-1"></i><%= student.email %>
                                                </a>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border px-2 py-1"><%= student.branch %></span>
                                            </td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-outline-warning me-1 edit-student-btn"
                                                        data-bs-toggle="modal" data-bs-target="#editModal"
                                                        data-bt="<%= student.bt_no %>"
                                                        data-name="<%= student.name %>"
                                                        data-year="<%= student.year %>"
                                                        data-phone="<%= student.phone %>"
                                                        data-email="<%= student.email %>"
                                                        data-branch="<%= student.branch %>"
                                                        title="Edit Student">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                                <form action="/room/students/delete/<%= encodeURIComponent(student.bt_no) %>" method="POST" style="display:inline;">
                                                    <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete student <%= student.bt_no %>?')" title="Delete Student">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr><td colspan="7" class="text-center text-muted py-4">No students found</td></tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Student Modal -->
<div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="addModalLabel"><i class="bi bi-person-plus"></i> Add New Student</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="addStudentForm" method="POST" action="/room/students/add">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">BT No / Roll No <span class="text-danger">*</span></label>
                        <input type="text" name="bt_no" id="addBtNo" class="form-control text-uppercase" 
                               placeholder="e.g. BT24CSE082" pattern="^[A-Za-z0-9_-]{4,20}$" 
                               maxlength="20" required>
                        <div class="form-text">Minimum 4 alphanumeric characters (automatically converted to uppercase).</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Student Name <span class="text-danger">*</span></label>
                        <input type="text" name="name" id="addName" class="form-control" 
                               placeholder="e.g. Harshal Mestri" pattern="^[a-zA-Z\s\.\-]{2,100}$" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Academic Year <span class="text-danger">*</span></label>
                        <select name="year" id="addYear" class="form-select" required>
                            <option value="" disabled selected>-- Select Academic Year --</option>
                            <option value="1">1st Year</option>
                            <option value="2">2nd Year</option>
                            <option value="3">3rd Year</option>
                            <option value="4">4th Year</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phone Number <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted fw-semibold">+91</span>
                            <input type="tel" name="phone" id="addPhone" class="form-control font-monospace" 
                                   placeholder="10-digit mobile number" 
                                   pattern="^[0-9]{10}$" maxlength="10" minlength="10" 
                                   inputmode="numeric" required>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <small class="text-muted" id="addPhoneHelp">Accepts exactly 10 numeric digits</small>
                            <small class="badge bg-secondary-subtle text-dark" id="addPhoneCount">0 / 10</small>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                        <input type="email" name="email" id="addEmail" class="form-control" 
                               placeholder="student@example.com" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Branch / Department <span class="text-danger">*</span></label>
                        <select name="branch" id="addBranch" class="form-select" required>
                            <option value="" disabled selected>Select Branch</option>
                            <option value="CSA">CSA — Computer Science &amp; AI</option>
                            <option value="CSD">CSD — Computer Science &amp; Data Science</option>
                            <option value="CSE">CSE — Computer Science &amp; Engineering</option>
                            <option value="CSH">CSH — Computer Science &amp; Human-Computer Interaction</option>
                            <option value="ECI">ECI — Electronics &amp; Communication (IoT)</option>
                            <option value="ECE">ECE — Electronics &amp; Communication Engineering</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Add Student</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Student Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="editModalLabel"><i class="bi bi-pencil-square"></i> Edit Student</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editStudentForm" method="POST" action="">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">BT No (Permanent Roll No)</label>
                        <input type="text" id="editBtNoDisplay" class="form-control bg-light font-monospace fw-bold" readonly disabled>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Student Name <span class="text-danger">*</span></label>
                        <input type="text" name="name" id="editName" class="form-control" 
                               pattern="^[a-zA-Z\s\.\-]{2,100}$" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Academic Year <span class="text-danger">*</span></label>
                        <select name="year" id="editYear" class="form-select" required>
                            <option value="1">1st Year</option>
                            <option value="2">2nd Year</option>
                            <option value="3">3rd Year</option>
                            <option value="4">4th Year</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phone Number <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted fw-semibold">+91</span>
                            <input type="tel" name="phone" id="editPhone" class="form-control font-monospace" 
                                   placeholder="10-digit mobile number" 
                                   pattern="^[0-9]{10}$" maxlength="10" minlength="10" 
                                   inputmode="numeric" required>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <small class="text-muted">Accepts exactly 10 numeric digits</small>
                            <small class="badge bg-secondary-subtle text-dark" id="editPhoneCount">0 / 10</small>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                        <input type="email" name="email" id="editEmail" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Branch / Department <span class="text-danger">*</span></label>
                        <select name="branch" id="editBranch" class="form-select" required>
                            <option value="" disabled>Select Branch</option>
                            <option value="CSA">CSA — Computer Science &amp; AI</option>
                            <option value="CSD">CSD — Computer Science &amp; Data Science</option>
                            <option value="CSE">CSE — Computer Science &amp; Engineering</option>
                            <option value="CSH">CSH — Computer Science &amp; Human-Computer Interaction</option>
                            <option value="ECI">ECI — Electronics &amp; Communication (IoT)</option>
                            <option value="ECE">ECE — Electronics &amp; Communication Engineering</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning"><i class="bi bi-check2-circle me-1"></i> Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Strict 10-digit numeric phone enforcement
    function setupPhoneValidation(inputId, countId) {
        const input = document.getElementById(inputId);
        const count = document.getElementById(countId);
        if (!input) return;

        function updateState() {
            // Strip any non-digit character instantly
            let clean = input.value.replace(/\D/g, '');
            if (clean.length > 10) clean = clean.slice(0, 10);
            input.value = clean;

            if (count) {
                count.textContent = `${clean.length} / 10`;
                if (clean.length === 10) {
                    count.className = 'badge bg-success-subtle text-success border border-success';
                    input.classList.remove('is-invalid');
                    input.classList.add('is-valid');
                } else if (clean.length > 0) {
                    count.className = 'badge bg-warning-subtle text-dark border';
                    input.classList.remove('is-valid');
                } else {
                    count.className = 'badge bg-secondary-subtle text-dark';
                    input.classList.remove('is-valid', 'is-invalid');
                }
            }
        }

        input.addEventListener('input', updateState);
        input.addEventListener('paste', () => setTimeout(updateState, 0));
        input.addEventListener('blur', function() {
            if (this.value && this.value.length !== 10) {
                this.classList.add('is-invalid');
            }
        });
    }

    setupPhoneValidation('addPhone', 'addPhoneCount');
    setupPhoneValidation('editPhone', 'editPhoneCount');

    // Auto-uppercase roll number and branch
    const addBtNo = document.getElementById('addBtNo');
    if (addBtNo) {
        addBtNo.addEventListener('input', function() {
            this.value = this.value.toUpperCase().replace(/[^A-Z0-9_-]/g, '');
        });
    }

    // Populate Edit Student Modal
    document.querySelectorAll('.edit-student-btn').forEach(button => {
        button.addEventListener('click', function() {
            const bt = this.dataset.bt;
            const name = this.dataset.name;
            const year = this.dataset.year;
            let phone = this.dataset.phone || '';
            const email = this.dataset.email;
            const branch = this.dataset.branch;

            // Extract last 10 digits if stored with country code or spaces
            const cleanDigits = phone.replace(/\D/g, '');
            const cleanPhone = cleanDigits.length >= 10 ? cleanDigits.slice(-10) : cleanDigits;

            document.getElementById('editStudentForm').action = `/room/students/edit/${encodeURIComponent(bt)}`;
            document.getElementById('editBtNoDisplay').value = bt;
            document.getElementById('editName').value = name;
            document.getElementById('editPhone').value = cleanPhone;
            document.getElementById('editEmail').value = email;
            document.getElementById('editBranch').value = branch;

            const editYearSelect = document.getElementById('editYear');
            if (editYearSelect) {
                if (['1', '2', '3', '4'].includes(String(year))) {
                    editYearSelect.value = String(year);
                } else {
                    // Default to 1st year if legacy 2024 or invalid
                    editYearSelect.value = '1';
                }
            }

            const countEl = document.getElementById('editPhoneCount');
            if (countEl) {
                countEl.textContent = `${cleanPhone.length} / 10`;
                if (cleanPhone.length === 10) {
                    countEl.className = 'badge bg-success-subtle text-success border border-success';
                } else {
                    countEl.className = 'badge bg-warning-subtle text-dark border';
                }
            }
        });
    });

    // Form submission validation
    function validateStudentForm(formId, phoneId) {
        const form = document.getElementById(formId);
        if (!form) return;
        form.addEventListener('submit', function(e) {
            const phoneInput = document.getElementById(phoneId);
            if (phoneInput && phoneInput.value.length !== 10) {
                e.preventDefault();
                alert('Please enter a valid 10-digit mobile number.');
                phoneInput.focus();
                phoneInput.classList.add('is-invalid');
                return false;
            }
        });
    }

    validateStudentForm('addStudentForm', 'addPhone');
    validateStudentForm('editStudentForm', 'editPhone');

    // Live search filter in student table
    const searchInput = document.getElementById('studentSearchInput');
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const filter = this.value.toLowerCase().trim();
            const rows = document.querySelectorAll('#studentTableBody tr');
            let matchCount = 0;

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                if (text.includes(filter)) {
                    row.style.display = '';
                    matchCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const countEl = document.getElementById('studentCount');
            if (countEl) countEl.textContent = matchCount;
        });
    }
</script>
</body>
</html>