<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rooms - Hostel Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { background-color: #f5f7fa; font-family: 'Segoe UI', sans-serif; }
        .sidebar { min-height: 100vh; background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%); }
        .sidebar a { color: #b8b8b8; text-decoration: none; padding: 12px 20px; display: block; border-radius: 8px; margin: 4px 10px; transition: all 0.3s; }
        .sidebar a:hover, .sidebar a.active { background: #0f3460; color: #fff; }
        .sidebar a i { margin-right: 10px; }
        .card { border: none; border-radius: 12px; box-shadow: 0 2px 15px rgba(0,0,0,0.05); }
        .navbar { background: linear-gradient(90deg, #1a1a2e 0%, #16213e 100%); }
    </style>
</head>
<body>
<div class="container-fluid">
    <div class="row">
        <div class="col-md-2 sidebar p-0">
            <div class="text-center py-4">
                <h5 class="text-white"><i class="bi bi-building"></i> Hostel</h5>
            </div>
            <a href="/room/students" class="<%= page === 'students' ? 'active' : '' %>"><i class="bi bi-people"></i> Students</a>
            <a href="/room/rooms" class="<%= page === 'rooms' ? 'active' : '' %>"><i class="bi bi-door-open"></i> Rooms</a>
            <a href="/room/allocations" class="<%= page === 'allocations' ? 'active' : '' %>"><i class="bi bi-person-plus"></i> Allocation</a>
            <a href="/room/leave" class="<%= page === 'leave' ? 'active' : '' %>"><i class="bi bi-calendar-minus"></i> Leave</a>
            <a href="/room/complaints" class="<%= page === 'complaints' ? 'active' : '' %>"><i class="bi bi-exclamation-triangle"></i> Complaints</a>
            <a href="/room/visitors" class="<%= page === 'visitors' ? 'active' : '' %>"><i class="bi bi-people"></i> Visitors</a>
            <a href="/room/payments" class="<%= page === 'payments' ? 'active' : '' %>"><i class="bi bi-currency-dollar"></i> Payments</a>
            <hr class="text-secondary">
            <div class="text-center text-secondary small py-2">MESS</div>
            <a href="/mess/fees" class="<%= page === 'fees' ? 'active' : '' %>"><i class="bi bi-cash"></i> Fees</a>
            <a href="/mess/leaves" class="<%= page === 'leaves' ? 'active' : '' %>"><i class="bi bi-calendar-minus"></i> Leaves & Refunds</a>
            <a href="/mess/menu" class="<%= page === 'menu' ? 'active' : '' %>"><i class="bi bi-list-ol"></i> Weekly Menu</a>
            <a href="/mess/inventory" class="<%= page === 'inventory' ? 'active' : '' %>"><i class="bi bi-box-seam"></i> Inventory</a>
            <a href="/mess/meals" class="<%= page === 'meals' ? 'active' : '' %>"><i class="bi bi-egg-fried"></i> Meal Log</a>
            <a href="/mess/staff" class="<%= page === 'staff' ? 'active' : '' %>"><i class="bi bi-person-badge"></i> Staff</a>
            <a href="/mess/vendors" class="<%= page === 'vendors' ? 'active' : '' %>"><i class="bi bi-truck"></i> Vendors</a>
            <a href="/mess/expenses" class="<%= page === 'expenses' ? 'active' : '' %>"><i class="bi bi-receipt"></i> Expenses</a>
            <a href="/mess/feedback" class="<%= page === 'feedback' ? 'active' : '' %>"><i class="bi bi-star"></i> Feedback</a>
            <a href="/mess/alerts" class="<%= page === 'alerts' ? 'active' : '' %>"><i class="bi bi-bell"></i> Alerts</a>
            <hr class="text-secondary">
            <div class="text-center text-secondary small py-2">SPORTS</div>
            <a href="/sports/dashboard" class="<%= page === 'sports-dashboard' ? 'active' : '' %>"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a href="/sports/inventory" class="<%= page === 'sports-inventory' ? 'active' : '' %>"><i class="bi bi-box-seam"></i> Inventory</a>
            <a href="/sports/issues" class="<%= page === 'sports-issues' ? 'active' : '' %>"><i class="bi bi-journal-arrow-up"></i> Issues</a>
            <a href="/sports/fines" class="<%= page === 'sports-fines' ? 'active' : '' %>"><i class="bi bi-cash-coin"></i> Fines</a>
        </div>
        <div class="col-md-10">
            <nav class="navbar navbar-expand-lg navbar-dark px-4">
                <span class="navbar-brand">Hostel Management System</span>
                <div class="ms-auto">
                    <a href="/logout" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right"></i> Logout</a>
                </div>
            </nav>
            <div class="p-4">
                <div class="page-header d-flex justify-content-between align-items-center">
                    <h4><i class="bi bi-door-open"></i> Room Management</h4>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addModal">
                        <i class="bi bi-plus"></i> Add Room
                    </button>
                </div>

                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Room No</th>
                                        <th>Capacity</th>
                                        <th>Floor</th>
                                        <th>Type</th>
                                        <th>Occupied</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (rooms.length > 0) { %>
                                        <% rooms.forEach(function(room) { %>
                                        <tr>
                                            <td><%= room.room_no %></td>
                                            <td><%= room.max_capacity %></td>
                                            <td><%= room.floor_no %></td>
                                            <td><%= room.room_type %></td>
                                            <td><%= room.occupied %></td>
                                            <td>
                                                <% if (room.occupied >= room.max_capacity) { %>
                                                <span class="badge bg-danger">Full</span>
                                                <% } else { %>
                                                <span class="badge bg-success">Available</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-warning me-1" onclick="openEditModal(<%= room.room_no %>, <%= room.max_capacity %>, <%= room.floor_no %>, '<%= room.room_type %>')">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <form action="/room/rooms/delete/<%= room.room_no %>" method="POST" style="display:inline;">
                                                    <button class="btn btn-sm btn-danger" onclick="return confirm('Delete room?')">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr><td colspan="7" class="text-center text-muted">No rooms found</td></tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Room</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="POST" action="/room/rooms/add">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Room No</label>
                        <input type="number" name="room_no" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Room Type</label>
                        <select name="room_type" id="add_room_type" class="form-select" onchange="syncCapacity('add_room_type','add_max_capacity')">
                            <option value="Single">Single (1 person)</option>
                            <option value="Double">Double (2 persons)</option>
                            <option value="Triple">Triple (3 persons)</option>
                            <option value="Dormitory">Dormitory (custom)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Max Capacity</label>
                        <input type="number" name="max_capacity" id="add_max_capacity" class="form-control" min="1" value="1" required>
                        <div class="form-text text-muted">Auto-filled by room type. Override for Dormitory.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Floor No</label>
                        <input type="number" name="floor_no" class="form-control" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Add Room</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Room Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil-square"></i> Edit Room</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="POST" id="editForm" action="">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Room No</label>
                        <input type="text" id="edit_room_no_display" class="form-control" disabled>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Room Type</label>
                        <select name="room_type" id="edit_room_type" class="form-select" onchange="syncCapacity('edit_room_type','edit_max_capacity')">
                            <option value="Single">Single (1 person)</option>
                            <option value="Double">Double (2 persons)</option>
                            <option value="Triple">Triple (3 persons)</option>
                            <option value="Dormitory">Dormitory (custom)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Max Capacity</label>
                        <input type="number" name="max_capacity" id="edit_max_capacity" class="form-control" min="1" required>
                        <div class="form-text text-muted">Auto-filled by room type. Override for Dormitory.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Floor No</label>
                        <input type="number" name="floor_no" id="edit_floor_no" class="form-control" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning"><i class="bi bi-save"></i> Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const capacityMap = { Single: 1, Double: 2, Triple: 3 };

    function syncCapacity(typeId, capId) {
        const type = document.getElementById(typeId).value;
        const capInput = document.getElementById(capId);
        if (capacityMap[type] !== undefined) {
            capInput.value = capacityMap[type];
            capInput.readOnly = true;
        } else {
            // Dormitory — allow custom
            capInput.readOnly = false;
            capInput.focus();
        }
    }

    // Init add modal on load
    document.addEventListener('DOMContentLoaded', function() {
        syncCapacity('add_room_type', 'add_max_capacity');
    });

    function openEditModal(roomNo, capacity, floor, type) {
        document.getElementById('edit_room_no_display').value = roomNo;
        document.getElementById('edit_floor_no').value = floor;
        document.getElementById('editForm').action = '/room/rooms/edit/' + roomNo;

        // Set room type dropdown
        const typeSelect = document.getElementById('edit_room_type');
        typeSelect.value = type;

        // Set capacity (and respect readonly logic)
        const capInput = document.getElementById('edit_max_capacity');
        capInput.value = capacity;
        if (capacityMap[type] !== undefined) {
            capInput.readOnly = true;
        } else {
            capInput.readOnly = false;
        }

        new bootstrap.Modal(document.getElementById('editModal')).show();
    }
</script>
</body>
</html>