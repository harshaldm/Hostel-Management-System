<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu - Hostel Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { background-color: #f5f7fa; font-family: 'Segoe UI', sans-serif; }
        .sidebar { min-height: 100vh; background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%); }
        .sidebar a { color: #b8b8b8; text-decoration: none; padding: 12px 20px; display: block; border-radius: 8px; margin: 4px 10px; }
        .sidebar a:hover, .sidebar a.active { background: #0f3460; color: #fff; }
        .card { border: none; border-radius: 12px; box-shadow: 0 2px 15px rgba(0,0,0,0.05); }
        .navbar { background: linear-gradient(90deg, #1a1a2e 0%, #16213e 100%); }
    </style>
</head>
<body>
<div class="container-fluid">
    <div class="row">
        <div class="col-md-2 sidebar p-0">
            <div class="text-center py-4"><h5 class="text-white"><i class="bi bi-building"></i> Hostel</h5></div>
            <a href="/room/students" class="<%= page === 'students' ? 'active' : '' %>"><i class="bi bi-people"></i> Students</a>
            <a href="/room/rooms" class="<%= page === 'rooms' ? 'active' : '' %>"><i class="bi bi-door-open"></i> Rooms</a>
            <a href="/room/allocations" class="<%= page === 'allocations' ? 'active' : '' %>"><i class="bi bi-person-plus"></i> Allocation</a>
            <a href="/room/leave" class="<%= page === 'leave' ? 'active' : '' %>"><i class="bi bi-calendar-minus"></i> Leave</a>
            <a href="/room/complaints" class="<%= page === 'complaints' ? 'active' : '' %>"><i class="bi bi-exclamation-triangle"></i> Complaints</a>
            <a href="/room/visitors" class="<%= page === 'visitors' ? 'active' : '' %>"><i class="bi bi-people"></i> Visitors</a>
            <hr class="text-secondary">
            <div class="text-center text-secondary small py-2">MESS</div>
            <a href="/mess/fees" class="<%= page === 'fees' ? 'active' : '' %>"><i class="bi bi-cash"></i> Fees</a>
            <a href="/mess/leaves" class="<%= page === 'leaves' ? 'active' : '' %>"><i class="bi bi-calendar-minus"></i> Leaves & Refunds</a>
            <a href="/mess/menu" class="<%= page === 'menu' ? 'active' : '' %>"><i class="bi bi-list-ol"></i> Weekly Menu</a>
            <a href="/mess/staff" class="<%= page === 'staff' ? 'active' : '' %>"><i class="bi bi-person-badge"></i> Staff</a>
            <a href="/mess/vendors" class="<%= page === 'vendors' ? 'active' : '' %>"><i class="bi bi-truck"></i> Vendors</a>
            <a href="/mess/expenses" class="<%= page === 'expenses' ? 'active' : '' %>"><i class="bi bi-receipt"></i> Expenses</a>
            <hr class="text-secondary">
            <div class="text-center text-secondary small py-2">SPORTS</div>
            <a href="/sports/dashboard" class="<%= page === 'sports-dashboard' ? 'active' : '' %>"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a href="/sports/inventory" class="<%= page === 'sports-inventory' ? 'active' : '' %>"><i class="bi bi-box-seam"></i> Inventory</a>
            <a href="/sports/issues" class="<%= page === 'sports-issues' ? 'active' : '' %>"><i class="bi bi-journal-arrow-up"></i> Issues</a>
            <a href="/sports/fines" class="<%= page === 'sports-fines' ? 'active' : '' %>"><i class="bi bi-cash-coin"></i> Fines</a>
        </div>
        <div class="col-md-10">
            <nav class="navbar navbar-expand-lg navbar-dark px-4">
                <span class="navbar-brand">Hostel Management System</span>
                <div class="ms-auto"><a href="/logout" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right"></i> Logout</a></div>
            </nav>
            <div class="p-4">
                <div class="page-header d-flex justify-content-between align-items-center">
                    <h4><i class="bi bi-list-ol"></i> Weekly Menu</h4>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addModal"><i class="bi bi-pencil"></i> Edit Menu</button>
                </div>
                <div class="row">
                    <% const days = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday']; %>
                    <% days.forEach(function(day) { %>
                    <div class="col-md-4 mb-3">
                        <div class="card">
                            <div class="card-header bg-primary text-white"><%= day %></div>
                            <div class="card-body">
                                <% const dayMenu = menu.filter(m => m.day_name === day); %>
                                <% dayMenu.forEach(function(m) { %>
                                <div class="mb-2"><strong><%= m.meal_type %>:</strong> <%= m.dish_name %></div>
                                <% }); %>
                            </div>
                        </div>
                    </div>
                    <% }); %>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Update Menu</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <form method="POST" action="/mess/menu/update">
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label">Day</label><select name="day_name" class="form-select"><option value="Monday">Monday</option><option value="Tuesday">Tuesday</option><option value="Wednesday">Wednesday</option><option value="Thursday">Thursday</option><option value="Friday">Friday</option><option value="Saturday">Saturday</option><option value="Sunday">Sunday</option></select></div>
                    <div class="mb-3"><label class="form-label">Meal Type</label><select name="meal_type" class="form-select"><option value="Breakfast">Breakfast</option><option value="Lunch">Lunch</option><option value="Dinner">Dinner</option></select></div>
                    <div class="mb-3"><label class="form-label">Dish</label><select name="dish_id" class="form-select"><% dishes.forEach(function(d) { %><option value="<%= d.dish_id %>"><%= d.dish_name %></option><% }); %></select></div>
                </div>
                <div class="modal-footer"><button type="submit" class="btn btn-primary">Update</button></div>
            </form>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>