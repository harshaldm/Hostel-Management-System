<% 
const pageTitle = 'Sports Inventory';
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sports Inventory - Hostel Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { background-color: #f5f7fa; font-family: 'Segoe UI', sans-serif; }
        .sidebar { min-height: 100vh; background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%); }
        .sidebar a { color: #b8b8b8; text-decoration: none; padding: 12px 20px; display: block; border-radius: 8px; margin: 4px 10px; transition: all 0.3s; }
        .sidebar a:hover, .sidebar a.active { background: #0f3460; color: #fff; }
        .sidebar a i { margin-right: 10px; }
        .card { border: none; border-radius: 12px; box-shadow: 0 2px 15px rgba(0,0,0,0.05); }
        .navbar { background: linear-gradient(90deg, #1a1a2e 0%, #16213e 100%); }
    </style>
</head>
<body>
<div class="container-fluid">
    <div class="row">
        <div class="col-md-2 sidebar p-0">
            <div class="text-center py-4">
                <h5 class="text-white"><i class="bi bi-building"></i> Hostel</h5>
            </div>
            <a href="/room/students" class="<%= page === 'students' ? 'active' : '' %>"><i class="bi bi-people"></i> Students</a>
            <a href="/room/rooms" class="<%= page === 'rooms' ? 'active' : '' %>"><i class="bi bi-door-open"></i> Rooms</a>
            <a href="/room/allocations" class="<%= page === 'allocations' ? 'active' : '' %>"><i class="bi bi-person-plus"></i> Allocation</a>
            <a href="/room/leave" class="<%= page === 'leave' ? 'active' : '' %>"><i class="bi bi-calendar-minus"></i> Leave</a>
            <a href="/room/complaints" class="<%= page === 'complaints' ? 'active' : '' %>"><i class="bi bi-exclamation-triangle"></i> Complaints</a>
            <a href="/room/visitors" class="<%= page === 'visitors' ? 'active' : '' %>"><i class="bi bi-people"></i> Visitors</a>
            <a href="/room/payments" class="<%= page === 'payments' ? 'active' : '' %>"><i class="bi bi-currency-dollar"></i> Payments</a>
            <hr class="text-secondary">
            <div class="text-center text-secondary small py-2">MESS</div>
            <a href="/mess/fees" class="<%= page === 'fees' ? 'active' : '' %>"><i class="bi bi-cash"></i> Fees</a>
            <a href="/mess/leaves" class="<%= page === 'leaves' ? 'active' : '' %>"><i class="bi bi-calendar-minus"></i> Leaves & Refunds</a>
            <a href="/mess/menu" class="<%= page === 'menu' ? 'active' : '' %>"><i class="bi bi-list-ol"></i> Weekly Menu</a>
            <a href="/mess/staff" class="<%= page === 'staff' ? 'active' : '' %>"><i class="bi bi-person-badge"></i> Staff</a>
            <a href="/mess/vendors" class="<%= page === 'vendors' ? 'active' : '' %>"><i class="bi bi-truck"></i> Vendors</a>
            <a href="/mess/expenses" class="<%= page === 'expenses' ? 'active' : '' %>"><i class="bi bi-receipt"></i> Expenses</a>
            <hr class="text-secondary">
            <div class="text-center text-secondary small py-2">SPORTS</div>
            <a href="/sports/dashboard" class="<%= page === 'sports-dashboard' ? 'active' : '' %>"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a href="/sports/inventory" class="<%= page === 'sports-inventory' ? 'active' : '' %>"><i class="bi bi-box-seam"></i> Inventory</a>
            <a href="/sports/issues" class="<%= page === 'sports-issues' ? 'active' : '' %>"><i class="bi bi-journal-arrow-up"></i> Issues</a>
            <a href="/sports/fines" class="<%= page === 'sports-fines' ? 'active' : '' %>"><i class="bi bi-cash-coin"></i> Fines</a>
        </div>
        <div class="col-md-10">
            <nav class="navbar navbar-expand-lg navbar-dark px-4">
                <span class="navbar-brand">Hostel Management System</span>
                <div class="ms-auto">
                    <a href="/logout" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right"></i> Logout</a>
                </div>
            </nav>
            <div class="p-4">
                <div class="page-header d-flex justify-content-between align-items-center">
                    <h4><i class="bi bi-box-seam"></i> Sports Equipment Inventory</h4>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addModal">
                        <i class="bi bi-plus"></i> Add Equipment
                    </button>
                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger"><%= error %></div>
                <% } %>

                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Item Name</th>
                                        <th>Total Qty</th>
                                        <th>Available</th>
                                        <th>Issued</th>
                                        <th>Fine/Day</th>
                                        <th>Cost/Item</th>
                                        <th>Total Value</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (items.length > 0) { %>
                                        <% items.forEach(function(item) { %>
                                        <tr>
                                            <td><strong><%= item.item_name %></strong></td>
                                            <td><span class="badge bg-primary"><%= item.total_quantity %></span></td>
                                            <td><span class="badge bg-success"><%= item.available_quantity %></span></td>
                                            <td><span class="badge bg-warning"><%= item.total_quantity - item.available_quantity %></span></td>
                                            <td>₹<%= item.fine_per_day %></td>
                                            <td>₹<%= item.cost_per_item %></td>
                                            <td>₹<%= item.total_cost %></td>
                                            <td>
                                                <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#editModal<%= item.item_id %>">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <form action="/sports/inventory/delete/<%= item.item_id %>" method="POST" style="display:inline;">
                                                    <button class="btn btn-sm btn-danger" onclick="return confirm('Delete this equipment?')">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                        <div class="modal fade" id="editModal<%= item.item_id %>" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Edit <%= item.item_name %></h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <form method="POST" action="/sports/inventory/update/<%= item.item_id %>">
                                                        <div class="modal-body">
                                                            <div class="mb-3">
                                                                <label class="form-label">Item Name</label>
                                                                <input type="text" name="item_name" class="form-control" value="<%= item.item_name %>" required>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label">Total Quantity</label>
                                                                <input type="number" name="total_quantity" class="form-control" value="<%= item.total_quantity %>" required>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label">Available Quantity</label>
                                                                <input type="number" name="available_quantity" class="form-control" value="<%= item.available_quantity %>" required>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label">Fine per Day (₹)</label>
                                                                <input type="number" name="fine_per_day" class="form-control" value="<%= item.fine_per_day %>" step="0.01">
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label">Cost per Item (₹)</label>
                                                                <input type="number" name="cost_per_item" class="form-control" value="<%= item.cost_per_item %>" step="0.01">
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="submit" class="btn btn-primary">Update</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                        <% }); %>
                                    <% } else { %>
                                        <tr><td colspan="8" class="text-center text-muted">No equipment found</td></tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Equipment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="POST" action="/sports/inventory/add">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Item Name</label>
                        <input type="text" name="item_name" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Total Quantity</label>
                        <input type="number" name="total_quantity" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Fine per Day (₹)</label>
                        <input type="number" name="fine_per_day" class="form-control" step="0.01" value="0">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cost per Item (₹)</label>
                        <input type="number" name="cost_per_item" class="form-control" step="0.01" value="0">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Add Equipment</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>