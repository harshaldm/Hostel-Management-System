<% 
const pageTitle = 'Sports Fines';
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sports Fines - Hostel Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { background-color: #f5f7fa; font-family: 'Segoe UI', sans-serif; }
        .sidebar { min-height: 100vh; background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%); }
        .sidebar a { color: #b8b8b8; text-decoration: none; padding: 12px 20px; display: block; border-radius: 8px; margin: 4px 10px; transition: all 0.3s; }
        .sidebar a:hover, .sidebar a.active { background: #0f3460; color: #fff; }
        .sidebar a i { margin-right: 10px; }
        .card { border: none; border-radius: 12px; box-shadow: 0 2px 15px rgba(0,0,0,0.05); }
        .navbar { background: linear-gradient(90deg, #1a1a2e 0%, #16213e 100%); }
    </style>
</head>
<body>
<div class="container-fluid">
    <div class="row">
        <div class="col-md-2 sidebar p-0">
            <div class="text-center py-4">
                <h5 class="text-white"><i class="bi bi-building"></i> Hostel</h5>
            </div>
            <a href="/room/students" class="<%= page === 'students' ? 'active' : '' %>"><i class="bi bi-people"></i> Students</a>
            <a href="/room/rooms" class="<%= page === 'rooms' ? 'active' : '' %>"><i class="bi bi-door-open"></i> Rooms</a>
            <a href="/room/allocations" class="<%= page === 'allocations' ? 'active' : '' %>"><i class="bi bi-person-plus"></i> Allocation</a>
            <a href="/room/leave" class="<%= page === 'leave' ? 'active' : '' %>"><i class="bi bi-calendar-minus"></i> Leave</a>
            <a href="/room/complaints" class="<%= page === 'complaints' ? 'active' : '' %>"><i class="bi bi-exclamation-triangle"></i> Complaints</a>
            <a href="/room/visitors" class="<%= page === 'visitors' ? 'active' : '' %>"><i class="bi bi-people"></i> Visitors</a>
            <a href="/room/payments" class="<%= page === 'payments' ? 'active' : '' %>"><i class="bi bi-currency-dollar"></i> Payments</a>
            <hr class="text-secondary">
            <div class="text-center text-secondary small py-2">MESS</div>
            <a href="/mess/fees" class="<%= page === 'fees' ? 'active' : '' %>"><i class="bi bi-cash"></i> Fees</a>
            <a href="/mess/leaves" class="<%= page === 'leaves' ? 'active' : '' %>"><i class="bi bi-calendar-minus"></i> Leaves & Refunds</a>
            <a href="/mess/menu" class="<%= page === 'menu' ? 'active' : '' %>"><i class="bi bi-list-ol"></i> Weekly Menu</a>
            <a href="/mess/inventory" class="<%= page === 'inventory' ? 'active' : '' %>"><i class="bi bi-box-seam"></i> Inventory</a>
            <a href="/mess/meals" class="<%= page === 'meals' ? 'active' : '' %>"><i class="bi bi-egg-fried"></i> Meal Log</a>
            <a href="/mess/staff" class="<%= page === 'staff' ? 'active' : '' %>"><i class="bi bi-person-badge"></i> Staff</a>
            <a href="/mess/vendors" class="<%= page === 'vendors' ? 'active' : '' %>"><i class="bi bi-truck"></i> Vendors</a>
            <a href="/mess/expenses" class="<%= page === 'expenses' ? 'active' : '' %>"><i class="bi bi-receipt"></i> Expenses</a>
            <a href="/mess/feedback" class="<%= page === 'feedback' ? 'active' : '' %>"><i class="bi bi-star"></i> Feedback</a>
            <a href="/mess/alerts" class="<%= page === 'alerts' ? 'active' : '' %>"><i class="bi bi-bell"></i> Alerts</a>
            <hr class="text-secondary">
            <div class="text-center text-secondary small py-2">SPORTS</div>
            <a href="/sports/dashboard" class="<%= page === 'sports-dashboard' ? 'active' : '' %>"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a href="/sports/inventory" class="<%= page === 'sports-inventory' ? 'active' : '' %>"><i class="bi bi-box-seam"></i> Inventory</a>
            <a href="/sports/issues" class="<%= page === 'sports-issues' ? 'active' : '' %>"><i class="bi bi-journal-arrow-up"></i> Issues</a>
            <a href="/sports/fines" class="<%= page === 'sports-fines' ? 'active' : '' %>"><i class="bi bi-cash-coin"></i> Fines</a>
        </div>
        <div class="col-md-10">
            <nav class="navbar navbar-expand-lg navbar-dark px-4">
                <span class="navbar-brand">Hostel Management System</span>
                <div class="ms-auto">
                    <a href="/logout" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right"></i> Logout</a>
                </div>
            </nav>
            <div class="p-4">
                <div class="page-header d-flex justify-content-between align-items-center">
                    <h4><i class="bi bi-cash-coin"></i> Sports Fines Management</h4>
                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger"><%= error %></div>
                <% } %>

                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card bg-danger text-white">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-0">Total Pending Fines</h6>
                                        <h2 class="mb-0">₹<%= totalFines.toFixed(2) %></h2>
                                    </div>
                                    <i class="bi bi-cash-coin" style="font-size: 2.5rem; opacity: 0.5;"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-warning text-dark">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-0">Total Fines Records</h6>
                                        <h2 class="mb-0"><%= fines.length %></h2>
                                    </div>
                                    <i class="bi bi-receipt" style="font-size: 2.5rem; opacity: 0.5;"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-success text-white">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-0">Average Fine</h6>
                                        <h2 class="mb-0">₹<%= fines.length > 0 ? (totalFines / fines.length).toFixed(2) : '0.00' %></h2>
                                    </div>
                                    <i class="bi bi-calculator" style="font-size: 2.5rem; opacity: 0.5;"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Pending Fines</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Fine ID</th>
                                        <th>BT No</th>
                                        <th>Student Name</th>
                                        <th>Equipment</th>
                                        <th>Issue Date</th>
                                        <th>Due Date</th>
                                        <th>Return Date</th>
                                        <th>Days Late</th>
                                        <th>Fine Amount</th>
                                        <th>Created Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (fines.length > 0) { %>
                                        <% fines.forEach(function(fine) { %>
                                        <%
                                            var due = fine.due_date ? new Date(fine.due_date) : null;
                                            var ret = fine.return_date ? new Date(fine.return_date) : null;
                                            var diffTime = (ret && due) ? ret - due : 0;
                                            var daysLate = diffTime > 0 ? Math.ceil(diffTime / (1000 * 60 * 60 * 24)) : 0;
                                        %>
                                        <tr>
                                            <td><%= fine.fine_id %></td>
                                            <td><%= fine.bt_no %></td>
                                            <td><%= fine.name %></td>
                                            <td><%= fine.item_name %></td>
                                            <td><%= fine.issue_date ? new Date(fine.issue_date).toLocaleDateString() : 'N/A' %></td>
                                            <td><%= fine.due_date ? new Date(fine.due_date).toLocaleDateString() : 'N/A' %></td>
                                            <td><%= fine.return_date ? new Date(fine.return_date).toLocaleDateString() : '-' %></td>
                                            <td><span class="badge bg-danger"><%= daysLate > 0 ? daysLate : 0 %> days</span></td>
                                            <td><span class="badge bg-danger">₹<%= parseFloat(fine.fine_amount || 0).toFixed(2) %></span></td>
                                            <td><%= fine.created_date ? new Date(fine.created_date).toLocaleDateString() : 'N/A' %></td>
                                            <td>
                                                <form action="/sports/fines/pay/<%= fine.fine_id %>" method="POST" style="display:inline;">
                                                    <button class="btn btn-sm btn-success" onclick="return confirm('Mark as paid?')">
                                                        <i class="bi bi-check-lg"></i> Paid
                                                    </button>
                                                </form>
                                                <form action="/sports/fines/waive/<%= fine.fine_id %>" method="POST" style="display:inline;">
                                                    <button class="btn btn-sm btn-warning" onclick="return confirm('Waive this fine?')">
                                                        <i class="bi bi-x-lg"></i> Waive
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr><td colspan="11" class="text-center text-muted">No pending fines</td></tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>