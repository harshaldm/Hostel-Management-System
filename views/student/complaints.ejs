<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Complaints - Student Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { background-color: #f5f7fa; font-family: 'Segoe UI', sans-serif; }
        .sidebar { min-height: 100vh; background: linear-gradient(180deg, #198754 0%, #0f5132 100%); }
        .sidebar a { color: #b8b8b8; text-decoration: none; padding: 12px 20px; display: block; border-radius: 8px; margin: 4px 10px; transition: all 0.3s; }
        .sidebar a:hover, .sidebar a.active { background: #146c43; color: #fff; }
        .sidebar a i { margin-right: 10px; }
        .card { border: none; border-radius: 12px; box-shadow: 0 2px 15px rgba(0,0,0,0.05); }
    </style>
</head>
<body>
<div class="container-fluid">
    <div class="row">
        <div class="col-md-2 sidebar p-0">
            <div class="text-center py-4">
                <h5 class="text-white"><i class="bi bi-mortarboard"></i> Student</h5>
                <p class="text-white-50 small mb-0"><%= student.bt_no %></p>
            </div>
            <a href="/student/profile" class="<%= page === 'profile' ? 'active' : '' %>"><i class="bi bi-person"></i> My Profile</a>
            <a href="/student/room" class="<%= page === 'room' ? 'active' : '' %>"><i class="bi bi-door-open"></i> My Room</a>
            <a href="/student/complaints" class="<%= page === 'complaints' ? 'active' : '' %>"><i class="bi bi-exclamation-triangle"></i> Complaints</a>
            <a href="/student/fines" class="<%= page === 'fines' ? 'active' : '' %>"><i class="bi bi-currency-dollar"></i> Pending Fines</a>
            <a href="/student/dues" class="<%= page === 'dues' ? 'active' : '' %>"><i class="bi bi-cash-stack"></i> Dues</a>
            <hr class="text-secondary">
            <div class="text-center text-secondary small py-2">REGISTERS</div>
            <a href="/student/mess-leave" class="<%= page === 'mess-leave' ? 'active' : '' %>"><i class="bi bi-cup-hot"></i> Mess Leave</a>
            <a href="/student/hostel-leave" class="<%= page === 'hostel-leave' ? 'active' : '' %>"><i class="bi bi-house"></i> Hostel Leave</a>
            <a href="/student/sports-issue" class="<%= page === 'sports-issue' ? 'active' : '' %>"><i class="bi bi-sportscourt"></i> Sports Issue</a>
            <hr class="text-secondary">
            <a href="/logout" class="text-danger"><i class="bi bi-box-arrow-right"></i> Logout</a>
        </div>
        <div class="col-md-10 p-4">
            <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger"><%= error %></div>
            <% } %>
            <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success"><%= success %></div>
            <% } %>

            <!-- Complaint Form -->
            <div class="card mb-4">
                <div class="card-header bg-white py-3">
                    <h4 class="mb-0"><i class="bi bi-pencil-square"></i> File a Complaint</h4>
                </div>
                <div class="card-body">
                    <% if (!room) { %>
                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-exclamation-circle"></i> No room allocated yet. You cannot file a room maintenance complaint until a room is allocated to you.
                    </div>
                    <% } else { %>
                    <p class="text-muted mb-3"><i class="bi bi-door-open"></i> Filing for: <strong>Room <%= room %></strong></p>
                    <form method="POST" action="/student/complaints/add">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Issue Type</label>
                                <select name="issue_type" class="form-select" required>
                                    <option value="">Select Issue Type</option>
                                    <option value="Electrical">Electrical</option>
                                    <option value="Plumbing">Plumbing</option>
                                    <option value="Furniture">Furniture</option>
                                    <option value="Cleaning">Cleaning</option>
                                    <option value="Internet">Internet</option>
                                    <option value="Pest Control">Pest Control</option>
                                </select>
                            </div>
                            <div class="col-md-8 mb-3">
                                <label class="form-label">Description (max 500 characters)</label>
                                <textarea name="description" class="form-control" rows="3" maxlength="500" required placeholder="Describe the issue..."></textarea>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success"><i class="bi bi-send"></i> Submit Complaint</button>
                    </form>
                    <% } %>
                </div>
            </div>

            <!-- My Complaints Table -->
            <div class="card">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="bi bi-list-check"></i> My Complaints</h4>
                    <span class="badge bg-secondary"><%= complaints.length %> Total</span>
                </div>
                <div class="card-body">
                    <% if (complaints.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Issue Type</th>
                                    <th>Complaint</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% complaints.forEach(function(c) { %>
                                <tr>
                                    <td><strong><%= c.issue_type %></strong></td>
                                    <td><%= c.description %></td>
                                    <td>
                                        <span class="badge <%= c.status === 'Resolved' ? 'bg-success' : c.status === 'In Progress' ? 'bg-warning text-dark' : c.status === 'Cancelled' ? 'bg-secondary' : 'bg-danger' %>">
                                            <%= c.status %>
                                        </span>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                    <% } else { %>
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle"></i> No complaints filed yet.
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
