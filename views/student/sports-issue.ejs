<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sports Issue - Student Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { background-color: #f5f7fa; font-family: 'Segoe UI', sans-serif; }
        .sidebar { min-height: 100vh; background: linear-gradient(180deg, #198754 0%, #0f5132 100%); }
        .sidebar a { color: #b8b8b8; text-decoration: none; padding: 12px 20px; display: block; border-radius: 8px; margin: 4px 10px; transition: all 0.3s; }
        .sidebar a:hover, .sidebar a.active { background: #146c43; color: #fff; }
        .sidebar a i { margin-right: 10px; }
        .card { border: none; border-radius: 12px; box-shadow: 0 2px 15px rgba(0,0,0,0.05); }
    </style>
</head>
<body>
<div class="container-fluid">
    <div class="row">
        <div class="col-md-2 sidebar p-0">
            <div class="text-center py-4">
                <h5 class="text-white"><i class="bi bi-mortarboard"></i> Student</h5>
                <p class="text-white-50 small mb-0"><%= student.bt_no %></p>
            </div>
            <a href="/student/profile" class="<%= page === 'profile' ? 'active' : '' %>"><i class="bi bi-person"></i> My Profile</a>
            <a href="/student/room" class="<%= page === 'room' ? 'active' : '' %>"><i class="bi bi-door-open"></i> My Room</a>
            <a href="/student/fines" class="<%= page === 'fines' ? 'active' : '' %>"><i class="bi bi-currency-dollar"></i> Pending Fines</a>
            <hr class="text-secondary">
            <div class="text-center text-secondary small py-2">REGISTERS</div>
            <a href="/student/mess-leave" class="<%= page === 'mess-leave' ? 'active' : '' %>"><i class="bi bi-cup-hot"></i> Mess Leave</a>
            <a href="/student/hostel-leave" class="<%= page === 'hostel-leave' ? 'active' : '' %>"><i class="bi bi-house"></i> Hostel Leave</a>
            <a href="/student/sports-issue" class="<%= page === 'sports-issue' ? 'active' : '' %>"><i class="bi bi-sportscourt"></i> Sports Issue</a>
            <hr class="text-secondary">
            <a href="/logout" class="text-danger"><i class="bi bi-box-arrow-right"></i> Logout</a>
        </div>
        <div class="col-md-10 p-4">
            <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
            <% } %>
            <div class="card mb-4">
                <div class="card-header bg-white py-3">
                    <h4 class="mb-0"><i class="bi bi-sportscourt"></i> Request Sports Equipment</h4>
                </div>
                <div class="card-body">
                    <form method="POST" action="/student/sports-issue/add">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label class="form-label">BT No</label>
                                    <input type="text" class="form-control" value="<%= student.bt_no %>" readonly>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label class="form-label">Name</label>
                                    <input type="text" class="form-control" value="<%= student.name %>" readonly>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label class="form-label">Equipment</label>
                                    <select name="item_id" class="form-select" required>
                                        <option value="">Select Equipment</option>
                                        <% items.forEach(item => { %>
                                        <option value="<%= item.item_id %>"><%= item.item_name %> (Available: <%= item.available_quantity %>)</option>
                                        <% }); %>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="mb-3">
                                    <label class="form-label">Quantity</label>
                                    <input type="number" name="quantity" class="form-control" value="1" min="1" required>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label class="form-label">Due Date</label>
                                    <input type="date" name="due_date" class="form-control" required>
                                </div>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success">Request Issue</button>
                    </form>
                </div>
            </div>
            <div class="card">
                <div class="card-header bg-white py-3">
                    <h4 class="mb-0"><i class="bi bi-clock-history"></i> My Sports Issues</h4>
                </div>
                <div class="card-body">
                    <% if (issues.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Quantity</th>
                                    <th>Issue Date</th>
                                    <th>Due Date</th>
                                    <th>Return Date</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% issues.forEach(issue => { %>
                                <tr>
                                    <td><%= issue.item_name %></td>
                                    <td><%= issue.quantity %></td>
                                    <td><%= issue.issue_date ? new Date(issue.issue_date).toLocaleDateString() : 'N/A' %></td>
                                    <td><%= issue.due_date ? new Date(issue.due_date).toLocaleDateString() : 'N/A' %></td>
                                    <td><%= issue.return_date ? new Date(issue.return_date).toLocaleDateString() : '-' %></td>
                                    <td>
                                        <% if (issue.status === 'Issued') { %>
                                        <span class="badge bg-primary">Issued</span>
                                        <% } else { %>
                                        <span class="badge bg-success">Returned</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (issue.status === 'Issued') { %>
                                        <form method="POST" action="/student/sports-issue/return/<%= issue.issue_id %>" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-outline-success">Return</button>
                                        </form>
                                        <% } else { %>
                                        -
                                        <% } %>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                    <% } else { %>
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> No sports issue records found.
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>